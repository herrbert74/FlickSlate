{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignoreDeps": [
    "org.hamcrest:hamcrest",
    "org.hamcrest:hamcrest-core",
    "com.michael-bull.kotlin-result:kotlin-result",
    "com.michael-bull.kotlin-result:kotlin-result-coroutines"
  ],
  "packageRules": [
    {
      "description": "Java is pinned to JDK 25 LTS; bump manually on the next LTS",
      "matchDatasources": [
        "java-version"
      ],
      "matchPackageNames": [
        "java",
        "java-jdk",
        "java-jre"
      ],
      "enabled": false
    },
    {
      "description": "Keep Kotlin compiler plugins and libraries in one PR. The JVM plugin is not linked to the JetBrains/kotlin source, so Renovate otherwise opens a second PR for the same version catalog entry.",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin($|[.:])/"
      ],
      "groupName": "kotlin monorepo",
      "groupSlug": "kotlin-monorepo"
    }
  ]
}
